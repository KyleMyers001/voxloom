{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxloom",
  "version": "0.1.0",
  "identifier": "com.voxloom.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [
        "main",
        "overlay"
      ]
    },
    "windows": [
      {
        "height": 760,
        "label": "main",
        "minHeight": 620,
        "minWidth": 640,
        "title": "Voxloom",
        "width": 1120
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/cleanup/*": "cleanup/"
    },
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
