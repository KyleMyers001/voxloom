{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxloom",
  "version": "0.1.0",
  "identifier": "com.voxloom.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": []
    },
    "windows": [
      {
        "height": 760,
        "label": "main",
        "minHeight": 620,
        "minWidth": 640,
        "title": "Voxloom · Mock Prototype",
        "width": 1120
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
