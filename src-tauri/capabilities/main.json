{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: capture, clipboard, global shortcut, overlay control, every app command except settings_request_onboarding.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focusable",
    "core:window:allow-set-always-on-top",
    "core:window:allow-current-monitor",
    "core:window:allow-get-all-windows",
    "core:window:allow-primary-monitor",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "allow-dictation-cancel-arm",
    "allow-dictation-cancel-finish",
    "allow-dictation-cancel-end",
    "allow-capture-cancel",
    "allow-capture-list-devices",
    "allow-capture-query-permission",
    "allow-capture-request-permission",
    "allow-capture-start",
    "allow-capture-status",
    "allow-capture-stop",
    "allow-cleanup-session-open",
    "allow-cleanup-session-dispose",
    "allow-cleanup-acquire",
    "allow-cleanup-cancel",
    "allow-cleanup-release",
    "allow-cleanup-run",
    "allow-cleanup-prewarm",
    "allow-cleanup-model-status",
    "allow-cleanup-pick-and-import-model",
    "allow-delivery-insert-text",
    "allow-delivery-snapshot-target",
    "allow-delivery-validate-target",
    "allow-dictionary-load",
    "allow-dictionary-save",
    "allow-history-load",
    "allow-history-save",
    "allow-hold-release-arm",
    "allow-hold-release-disarm",
    "allow-overlay-ensure",
    "allow-overlay-hide",
    "allow-overlay-show",
    "allow-settings-load",
    "allow-settings-save",
    "allow-settings-window-open",
    "allow-store-backup",
    "allow-stt-cancel-download",
    "allow-stt-download-model",
    "allow-stt-list-models",
    "allow-stt-model-status",
    "allow-stt-transcribe"
  ]
}
